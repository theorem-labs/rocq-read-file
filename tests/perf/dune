(coq.theory
 (name ReadFile_Perf)
 (theories ReadFile Stdlib)
 (plugins rocq-read-file.plugin))

; Generate test data via /dev/urandom so no external script is needed.
(rule (targets small.bin)
 (action (system "printf 'Hello!' > %{targets}")))
(rule (targets rand_1k.bin)
 (action (system "dd if=/dev/urandom of=%{targets} bs=1024 count=1 2>/dev/null")))
(rule (targets rand_64k.bin)
 (action (system "dd if=/dev/urandom of=%{targets} bs=1024 count=64 2>/dev/null")))
(rule (targets rand_1m.bin)
 (action (system "dd if=/dev/urandom of=%{targets} bs=1024 count=1024 2>/dev/null")))
(rule (targets rand_4m.bin)
 (action (system "dd if=/dev/urandom of=%{targets} bs=4096 count=1024 2>/dev/null")))
(rule (targets rand_16m.bin)
 (action (system "dd if=/dev/urandom of=%{targets} bs=4096 count=4096 2>/dev/null")))
(rule (targets rand_64m.bin)
 (action (system "dd if=/dev/urandom of=%{targets} bs=4096 count=16384 2>/dev/null")))
(rule (targets text_1m.txt)
 (action (system "dd if=/dev/urandom bs=4096 count=2048 2>/dev/null | LC_ALL=C tr -dc 'A-Za-z0-9 \\n' | head -c 1048576 > %{targets}")))
(rule (targets text_16m.txt)
 (action (system "dd if=/dev/urandom bs=4096 count=32768 2>/dev/null | LC_ALL=C tr -dc 'A-Za-z0-9 \\n' | head -c 16777216 > %{targets}")))

; Work around missing dune support for Extra Dependency.
; https://github.com/ocaml/dune/pull/9591
(rule
 (target dep_hashes.v)
 (deps small.bin rand_1k.bin rand_64k.bin rand_1m.bin rand_4m.bin
       rand_16m.bin rand_64m.bin text_1m.txt text_16m.txt)
 (action
  (with-stdout-to %{target}
   (run rocq-read-file-shafile %{deps}))))
