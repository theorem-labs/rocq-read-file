; Tests are a separate Coq theory. The data/ subdirectory is
; populated by ./gen.sh before building.
;
; copy_files brings the generated files into _build/default/tests/
; so coqc can find them next to the .v files (basename, no path).

(coq.theory
 (name ReadFile_Tests)
 (theories ReadFile))

(copy_files data/*.bin)
(copy_files data/*.txt)
