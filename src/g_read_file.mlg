DECLARE PLUGIN "rocq-read-file.plugin"

{

open Ltac_plugin
open Stdarg
open Procq.Prim
open Read_file

let int = integer

let mk_slice (off, len) : Read_file.slice =
  { offset = off; length = len }

}

(* ------------------------------------------------------------------ *)
(* Optional [Offset N] [Length N] suffix.                             *)
(* ------------------------------------------------------------------ *)

ARGUMENT EXTEND slice_spec
TYPED AS (int option * int option)
PRINTED BY { fun _ _ _ _ -> Pp.mt () }
| [ "Offset" int(o) "Length" int(l) ] -> { (Some o, Some l) }
| [ "Offset" int(o) ]                 -> { (Some o, None)   }
| [ "Length" int(l) ]                 -> { (None,   Some l) }
| [ ]                                 -> { (None,   None)   }
END

(* ------------------------------------------------------------------ *)
(* The three vernacular commands.                                     *)
(* File source may be a string path or an Extra Dependency ident.     *)
(* ------------------------------------------------------------------ *)

VERNAC COMMAND EXTEND ReadFile CLASSIFIED AS SIDEFF

| [ "ReadFileBytes" string(file) "As" ident(name) slice_spec(s) ] ->
  { Read_file.read_bytes (FilePath file) name None (mk_slice s) }
| [ "ReadFileBytes" ident(dep) "As" ident(name) slice_spec(s) ] ->
  { Read_file.read_bytes (ExtraDepIdent dep) name None (mk_slice s) }

| [ "ReadFileBytes" string(file) "As" ident(name) ":" reference(t)
    slice_spec(s) ] ->
  { Read_file.read_bytes (FilePath file) name (Some t) (mk_slice s) }
| [ "ReadFileBytes" ident(dep) "As" ident(name) ":" reference(t)
    slice_spec(s) ] ->
  { Read_file.read_bytes (ExtraDepIdent dep) name (Some t) (mk_slice s) }

| [ "ReadFileInt63" "LittleEndian" string(file) "As" ident(name)
    slice_spec(s) ] ->
  { Read_file.read_int63 (FilePath file) name LittleEndian (mk_slice s) }
| [ "ReadFileInt63" "LittleEndian" ident(dep) "As" ident(name)
    slice_spec(s) ] ->
  { Read_file.read_int63 (ExtraDepIdent dep) name LittleEndian (mk_slice s) }

| [ "ReadFileInt63" "BigEndian" string(file) "As" ident(name)
    slice_spec(s) ] ->
  { Read_file.read_int63 (FilePath file) name BigEndian (mk_slice s) }
| [ "ReadFileInt63" "BigEndian" ident(dep) "As" ident(name)
    slice_spec(s) ] ->
  { Read_file.read_int63 (ExtraDepIdent dep) name BigEndian (mk_slice s) }

| [ "ReadFileString" string(file) "As" ident(name) slice_spec(s) ] ->
  { Read_file.read_string (FilePath file) name (mk_slice s) }
| [ "ReadFileString" ident(dep) "As" ident(name) slice_spec(s) ] ->
  { Read_file.read_string (ExtraDepIdent dep) name (mk_slice s) }

| [ "Set" "ReadFile" "MaxArrayLength" int(n) ] ->
  { Read_file.set_max_array_length n }

| [ "Unset" "ReadFile" "MaxArrayLength" ] ->
  { Read_file.reset_max_array_length () }

END
