(library
 (name read_file_plugin)
 (public_name rocq-read-file.plugin)
 (synopsis "Read files into Rocq as primitive arrays / strings")
 (flags :standard -rectypes -w -27-32-33-39)
 (libraries coq-core.plugins.ltac))

(coq.pp (modules g_read_file))

(rule
 (target compat.ml)
 (deps compat.cppo.ml)
 (action (run cppo -V COQ_VERSION:%{coq:version} %{deps} -o %{target})))
